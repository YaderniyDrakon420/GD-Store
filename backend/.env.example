DJANGO_SECRET_KEY=dev-only-secret-change-me-before-deployment-2026
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Explicitly set to 1 ONLY for educational purchases/top-ups. No real funds.
PAYMENT_TEST_MODE=0
PAYMENT_WEBHOOK_SECRET=

# SQLite works without installing a database server.
DB_ENGINE=sqlite
# SQL Server alternative: create gdstore first, set DB_ENGINE=mssql and credentials.
DB_NAME=gdstore
DB_USER=sa
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes;

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep Lax for local development, reverse proxy or HTTPS sibling subdomains.
# Unrelated HTTPS frontend/backend domains may require None, but browsers can
# still block third-party cookies. A frontend reverse proxy avoids that issue.
SESSION_COOKIE_SAMESITE=Lax
