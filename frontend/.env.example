# Local development or a frontend host that proxies /api and /media to Django:
VITE_API_BASE_URL=/api/v1/

# Direct API on a different origin (requires backend CORS/CSRF settings):
# VITE_API_BASE_URL=https://api.example.com/api/v1/

# Vite development proxy only. Not used by the production build.
API_PROXY_TARGET=http://127.0.0.1:8000
